{
  "name": "design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/development/dev.mjs",
    "build": "pnpm build:renderer && vite build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migrate; fi && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit && pnpm typecheck:renderer",
    "sync:digicomponents": "node scripts/libraries/sync-digicomponents.mjs",
    "dev:studio": "vite dev --host 127.0.0.1 --port 3402 --strictPort",
    "build:renderer": "pnpm --filter @digit-ai-studio/renderer build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck:renderer": "vue-tsc --noEmit -p renderer/tsconfig.json",
    "test:db": "vitest run --config vitest.database.config.ts",
    "auth:seed-dev": "NODE_ENV=development tsx scripts/development/seed-dev.ts",
    "start": "node .output/server/index.mjs",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.62",
