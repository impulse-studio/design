POSTGRES_DB=digit_ai_studio
POSTGRES_USER=digit
POSTGRES_PASSWORD=digit_dev
POSTGRES_PORT=5433

# Utilisée ensuite par le serveur TanStack Start / Drizzle.
DATABASE_URL=postgresql://digit:digit_dev@localhost:5433/digit_ai_studio

# Web : clé d’environnement Trigger (jamais VITE_*), secret partagé avec le worker.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
AI_CALLBACK_SECRET=
# Liste explicite de modèles API autorisés, identique sur web et Trigger.
AI_MODELS=[]
AI_DEFAULT_MODEL=
# Activer uniquement les fournisseurs dont la clé existe sur Trigger.
AI_ENABLED_PROVIDERS=
# Worker Trigger uniquement : URL HTTPS publique du studio + clés centrales.
AI_STUDIO_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

BETTER_AUTH_URL=http://localhost:3402
# Générer deux secrets distincts avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
DEV_AUTH_PASSWORD=
# Uniquement avec NODE_ENV=development et une URL localhost/127.0.0.1.
AUTH_DEV_MODE=true

# En production : AUTH_DEV_MODE=false, URL HTTPS et identifiants Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
