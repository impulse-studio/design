{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "jsx": "react-jsx", "types": ["vite/client"],
